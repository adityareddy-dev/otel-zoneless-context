{
  "name": "otel-zoneless-context",
  "version": "0.1.0",
  "description": "OpenTelemetry context manager for the browser that keeps context across native await, with a bundler plugin, no zone.js",
  "license": "Apache-2.0",
  "author": "Aditya Reddy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityareddy-dev/otel-zoneless-context.git"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/node/*.test.mjs\"",
    "test:browser": "node --test \"test/browser/*.test.mjs\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "opentelemetry",
    "context-manager",
    "zoneless",
    "async-await",
    "browser",
    "vite-plugin",
    "rollup-plugin",
    "webpack-plugin",
    "esbuild-plugin"
  ],
  "peerDependencies": {
    "@opentelemetry/api": "^1.3.0"
  },
  "dependencies": {
    "magic-string": "^1.4.3",
    "oxc-parser": "^0.153.0",
    "unplugin": "^3.4.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-zone": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-web": "^2.12.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "rollup": "^4.64.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "webpack": "^5.111.1",
    "zone.js": "^0.16.3"
  }
}
